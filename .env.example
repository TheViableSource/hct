# Server-only settings. Never use NEXT_PUBLIC_ for these values.
# Comma-separated exact origins, no trailing slashes. Local: http://localhost:3000
HCT_FORM_ORIGINS=https://hillsborocivictheatre.com
# REQUIRED: verified absolute private path outside app, public, Git and deployment trees.
# Do not use this placeholder. An admin initializes the directory/store first.
HCT_FORM_DATA_DIR=

# CMS stays off until private storage and editor invitations are approved.
# HCT_CMS_DATA_DIR=/absolute/private/hct-cms
# HCT_CMS_ORIGIN=https://hillsborocivictheatre.com

# Outbound mail is OFF until backed-up migration and authenticated SMTP setup.
HCT_FORM_MAIL_QUEUE_ENABLED=false
HCT_MAIL_DELIVERY_ENABLED=false
# HCT_MAIL_OWNER=approved-owner@example.com
# SMTP secrets belong only in approved private server configuration.
